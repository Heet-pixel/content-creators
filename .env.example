# ── Database ─────────────────────────────────────────────
# Local dev default. On Render, replace with your MongoDB Atlas
# connection string (Render does not host MongoDB itself).
MONGODB_URI=mongodb://localhost:27017/conten

# ── Server ───────────────────────────────────────────────
PORT=5000

# ── Auth ─────────────────────────────────────────────────
# Change this to a long random string in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# ── Admin accounts ───────────────────────────────────────
# Comma-separated email:password pairs — supports multiple admin
# logins. New accounts here are created automatically on server
# start; existing ones are never overwritten.
#   ADMIN_ACCOUNTS=owner@gmail.com:pass123,manager@gmail.com:pass456
ADMIN_ACCOUNTS=contentcrafters.in@gmail.com:12345678

# ── Email (Nodemailer) ───────────────────────────────────
# Leave these blank to run in "demo mode": emails are logged to
# the server console instead of actually being sent. Fill them
# in with real SMTP credentials (e.g. Gmail app password, SendGrid,
# Mailgun, Resend, etc.) when you're ready to go live.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Content Crafters <no-reply@contentcrafters.in>"

# Where new-enquiry notifications are sent (usually your real inbox).
ADMIN_NOTIFY_EMAIL=

# Where "Forgot password" OTP codes are sent. If blank, falls back to
# whichever admin email requested the reset.
ADMIN_RECOVERY_EMAIL=
